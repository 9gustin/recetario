# Variables de entorno de Recetario.
# Copiá este archivo a .env.local y completá los valores. Nunca commitees .env.local.
# Dónde se carga cada una en producción: docs/deploy.md → "Variables de entorno".

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Local: los imprime `pnpm supabase status`. Producción: Supabase → Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Ignora RLS: nunca exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Monitoreo (opcional: sin estas variables quedan desactivados) ---
# Sentry (errores). Crear proyecto Next.js en sentry.io → Settings → Client Keys (DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# PostHog (analytics). Project settings → Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- IA (Anthropic) ---
# console.anthropic.com → API Keys. Solo servidor.
ANTHROPIC_API_KEY=

# --- Voz → texto ---
# Proveedor único por ahora: openai (modelo gpt-4o-transcribe). platform.openai.com → API keys. Solo servidor.
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
